# ============================================
# Deep Research Agent Platform — Environment
# ============================================

# --- LLM ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Anthropic fallback (optional)
ANTHROPIC_API_KEY=

# --- Agent Core ---
AGENT_CORE_STORE_BACKEND=sqlite
AGENT_CORE_STORE_SQLITE_PATH=./data/agent_core_store.sqlite3

# --- MCP Search ---
MCP_SEARCH_ENABLED=true
MCP_SEARCH_SERVER_URL=http://127.0.0.1:3210
MCP_SEARCH_DEFAULT_ENGINE=baidu
MCP_SEARCH_FALLBACK_ENGINES=sogou,bing

# --- RAG ---
CHROMA_DB_PATH=./data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Java Backend ---
JWT_SECRET=change-me-in-production
DB_PASSWORD=deepresearch
