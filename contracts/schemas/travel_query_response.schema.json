{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel.intelligence/contracts/schemas/travel_query_response.schema.json",
  "title": "TravelQueryResponse",
  "description": "POST /api/travel/query response body. Minimum contract surface for Java / Web clients.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "answer",
    "visible_trace",
    "evidence_summary",
    "limitations",
    "confidence",
    "tool_traces",
    "answer_claims",
    "citation_report",
    "retrieval_reports",
    "metrics",
    "orchestration_summary"
  ],
  "properties": {
    "promotion_summary": {"oneOf":[{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["not_attempted","disabled","rejected","pending_review","published","partial","failed","unknown"]},"candidate_count":{"type":"integer","minimum":0,"maximum":4,"default":0},"published_count":{"type":"integer","minimum":0,"maximum":4,"default":0},"pending_count":{"type":"integer","minimum":0,"maximum":4,"default":0},"rejected_count":{"type":"integer","minimum":0,"maximum":4,"default":0}}},{"type":"null"}]},
    "index_sync_status": {"oneOf":[{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["not_applicable","pending","indexed","failed","unknown"]},"pending_count":{"type":"integer","minimum":0,"maximum":4,"default":0},"indexed_count":{"type":"integer","minimum":0,"maximum":4,"default":0},"failed_count":{"type":"integer","minimum":0,"maximum":4,"default":0}}},{"type":"null"}]},
    "answer": {
      "type": "string",
      "description": "Natural-language answer composed from evidence."
    },
    "session_id": { "type": ["string", "null"] },
    "query_id": { "type": ["string", "null"] },
    "visible_trace": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "evidence_summary": {
      "type": "array",
      "description": "Summarized evidence objects or dict views.",
      "items": {
        "oneOf": [
          { "$ref": "evidence.schema.json" },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0
    },
    "tool_traces": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "tool_trace.schema.json" },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "structured_result": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional structured payload; Python may include richer fields."
    },
    "field_evidence_summary": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "default": []
    },
    "citation_check_result": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "semantic_frame_summary": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "null" }
      ]
    },
    "answer_mode": { "type": ["string", "null"] },
    "answer_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "claim_type", "hard_fact", "evidence_ids"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "claim_type": { "type": "string", "minLength": 1 },
          "hard_fact": { "type": "boolean" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "attraction_id": { "type": ["string", "null"] },
          "subtask_id": { "type": ["string", "null"] },
          "conflict_disclosed": { "type": "boolean", "default": false }
        }
      },
      "default": []
    },
    "citation_report": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "safe_failure", "decisions", "supported_claim_ids", "removed_claim_ids", "unsupported_hard_fact_count", "citation_precision"],
          "properties": {
            "passed": { "type": "boolean" },
            "safe_failure": { "type": "boolean" },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claim_id", "status", "reason", "evidence_ids"],
                "properties": {
                  "claim_id": { "type": "string" },
                  "status": { "enum": ["supported", "unsupported_removed", "soft_claim_allowed"] },
                  "reason": { "type": "string" },
                  "evidence_ids": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "supported_claim_ids": { "type": "array", "items": { "type": "string" } },
            "removed_claim_ids": { "type": "array", "items": { "type": "string" } },
            "unsupported_hard_fact_count": { "type": "integer", "minimum": 0 },
            "citation_precision": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "retrieval_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["subtask_id", "retrieval_plan", "corpus_version", "lexical_attempt", "dense_attempt", "final_hits", "degradation", "latency_breakdown"],
        "properties": {
          "subtask_id": { "type": "string" },
          "corpus_version": { "type": "string" },
          "index_generation": { "type": ["string", "null"] },
          "embedding_model": { "type": ["string", "null"] },
          "retrieval_plan": { "type": "object" },
          "lexical_attempt": { "$ref": "#/$defs/retrievalAttempt" },
          "dense_attempt": { "$ref": "#/$defs/retrievalAttempt" },
          "final_hits": { "type": "array", "items": { "type": "object" } },
          "degradation": { "enum": ["none", "lexical_only", "dense_only", "no_results", "all_failed"] },
          "latency_breakdown": { "type": "object" }
        }
      },
      "default": []
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "orchestration_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "terminal_state"],
      "properties": {
        "run_id": { "type": "string" },
        "terminal_state": { "type": "string" },
        "trace_id": { "type": ["string", "null"] },
        "steps": { "type": "integer", "minimum": 0 },
        "state_audit": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "retrievalAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "status", "result_count", "latency_ms"],
      "properties": {
        "channel": { "enum": ["lexical", "dense"] },
        "status": { "enum": ["success", "empty", "failed", "skipped"] },
        "result_count": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "failure_code": { "type": ["string", "null"] }
      }
    }
  }
}
