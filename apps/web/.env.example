# Gateway mode (default): the Vue app calls the Java backend.
VITE_DIRECT_AGENT=false
VITE_API_BASE_URL=http://127.0.0.1:8082

# Direct agent mode: useful when running scripts/start-agent.ps1 without Java.
# VITE_DIRECT_AGENT=true
# VITE_AGENT_BASE_URL=http://127.0.0.1:8001

# Browser request timeout for long research runs.
VITE_QUERY_TIMEOUT_MS=300000
