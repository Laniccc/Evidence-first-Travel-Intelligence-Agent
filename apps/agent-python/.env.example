# HTTP boundary
AGENT_SERVICE_KEY=change-me
LOG_LEVEL=INFO

# Optional LLM understanding. Offline tests never call it.
LLM_MODE=anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Authoritative, versioned knowledge store
KNOWLEDGE_DB_PATH=./data/knowledge.sqlite3
KNOWLEDGE_DEFAULT_TTL_DAYS=30
KNOWLEDGE_RETRIEVAL_TOP_K=3

# Rebuildable dense index. SQLite remains the source of truth.
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=attraction-facts
QDRANT_LOCAL_PATH=./data/qdrant
EMBEDDING_MODE=deterministic
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
VECTOR_SEARCH_LIMIT=20
READINESS_REQUIRES_QDRANT=false

# Audit, evidence, answer-claim and replay store
AGENT_RUN_DB_PATH=./data/agent_runs.sqlite3

# Optional bounded live gap-fill dependencies
MCP_ENABLED=false
MCP_PROFILE=off
MCP_SEARCH_ENABLED=false
MCP_SEARCH_SERVER_URL=http://127.0.0.1:3210
OFFICIAL_SOURCE_DISCOVERY_ENABLED=false
