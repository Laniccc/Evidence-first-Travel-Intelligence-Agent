# Copy to .env and export before `mvn spring-boot:run`, or set in your shell.
AGENT_BASE_URL=http://localhost:8001

# Platform persistence and auth
APP_DB_URL=jdbc:h2:file:./data/api-java-db;AUTO_SERVER=TRUE;MODE=PostgreSQL
APP_DB_USER=sa
APP_DB_PASSWORD=
APP_JPA_DDL_AUTO=update
APP_JWT_SECRET=dev-change-me-to-a-long-random-secret-before-sharing
APP_JWT_TTL_MINUTES=720
H2_CONSOLE_ENABLED=true

# Tool Gateway / MCP (search_mcp)
TOOL_GATEWAY_ENABLED=true
MCP_ENABLED=false
MCP_SEARCH_ENABLED=false
MCP_SEARCH_SERVER_URL=
MCP_SEARCH_TOOL_NAME=public_web_search
MCP_TIMEOUT_SECONDS=30
